<header id="inicio" class="hero">
  <div class="container hero-content">
    <div class="row align-items-center g-5">
      <div class="col-lg-7">
        <span class="hero-badge"><i class="bi bi-geo-alt-fill text-warning"></i> Plataforma turística definitiva</span>
        <h1>Explora, planifica y vive Puerto Montt</h1>
        <p>
          Plataforma web turística con atractivos, gastronomía, menús, login, registro, recuperación de contraseña,
          favoritos, itinerario, presupuesto, reseñas, contacto y panel personalizado.
        </p>
        <div class="d-flex gap-3 flex-wrap justify-content-center justify-content-lg-start">
          <a href="#atractivos" class="btn btn-main"><i class="bi bi-map me-2"></i>Ver lugares</a>
          <button class="btn btn-outline-light-custom" data-bs-toggle="modal" data-bs-target="#registerModal">
            <i class="bi bi-person-plus me-2"></i>Crear cuenta
          </button>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="hero-panel">
          <h5 class="fw-bold mb-3"><i class="bi bi-stars text-warning me-2"></i>Funciones principales</h5>
          <div class="mini-feature"><i class="bi bi-person-lock"></i><span>Login, registro y recuperación de contraseña.</span></div>
          <div class="mini-feature"><i class="bi bi-cup-hot"></i><span>Menús recomendados y platos típicos.</span></div>
        </div>
      </div>
    </div>
  </div>
</header>

<section id="atractivos">
