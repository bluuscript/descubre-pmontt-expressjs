<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel | Descubre Puerto Montt</title>
  <link href="/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --azul: #023047;  
      --azul2: #126782;
      --celeste: #219ebc;
      --amarillo: #ffb703;
      --naranja: #fb8500;
      --fondo: #f4f8fb;
      --texto: #263238;
      --muted: #607d8b;
      --card: #ffffff;
      --sombra: 0 18px 45px rgba(2,48,71,.12);
    }

    * {
      font-family: 'Poppins', sans-serif;
      scroll-behavior: smooth;
    }

    body {
      background: var(--fondo);
      color: var(--texto);
      overflow-x: hidden;
    }

    .navbar {
      background: rgba(2,48,71,.96);
      backdrop-filter: blur(12px);
      box-shadow: 0 8px 25px rgba(0,0,0,.18);
    }

    .navbar-brand {
      color: #fff !important;
      font-weight: 800;
    }

    .navbar-brand span {
      color: var(--amarillo);
    }

    .nav-link {
      color: rgba(255,255,255,.9) !important;
      font-weight: 600;
      border-radius: 999px;
      padding: 8px 13px !important;
    }

    .nav-link:hover,
    .nav-link.active {
      background: rgba(255,183,3,.16);
      color: var(--amarillo) !important;
    }

    .user-header {
      padding: 125px 0 50px;
      color: white;
      background:
        radial-gradient(circle at 20% 30%, rgba(255,183,3,.22), transparent 28%),
        linear-gradient(115deg, rgba(2,48,71,.94), rgba(18,103,130,.78)),
        url('https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1800&q=85');
      background-size: cover;
      background-position: center;
    }

    .user-badge {
      display: inline-flex;
      gap: 8px;
      align-items: center;
      padding: 9px 16px;
      border-radius: 999px;
      background: rgba(255,255,255,.14);
      border: 1px solid rgba(255,255,255,.25);
      margin-bottom: 16px;
    }

    .user-header h1 {
      font-weight: 800;
      font-size: clamp(2.2rem, 5vw, 4.4rem);
      letter-spacing: -1.5px;
      margin-bottom: 12px;
    }

    .user-header p {
      color: rgba(255,255,255,.88);
      max-width: 820px;
      margin-bottom: 0;
    }

    main {
      padding: 55px 0 80px;
    }

    .card-box,
    .metric-card,
    .place-card,
    .review-card,
    .side-card {
      background: var(--card);
      border: 1px solid rgba(2,48,71,.08);
      border-radius: 26px;
      box-shadow: var(--sombra);
      height: 100%;
    }

    .metric-card {
      padding: 25px;
      text-align: center;
    }

    .metric-card i {
      font-size: 2rem;
      color: var(--naranja);
    }

    .metric-card h3 {
      font-weight: 800;
      font-size: 2.25rem;
      margin: 10px 0 0;
    }

    .metric-card p {
      color: var(--muted);
      margin: 0;
    }

    .card-box,
    .side-card,
    .review-card {
      padding: 26px;
    }

    .section-kicker {
      display: inline-block;
      color: var(--naranja);
      background: rgba(251,133,0,.12);
      font-weight: 800;
      font-size: .78rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      border-radius: 999px;
      padding: 7px 13px;
      margin-bottom: 12px;
    }

    .section-title h2 {
      font-weight: 800;
      letter-spacing: -1px;
      font-size: clamp(1.8rem, 4vw, 3rem);
    }

    .btn-main {
      background: linear-gradient(135deg, var(--amarillo), var(--naranja));
      color: var(--azul);
      border: none;
      border-radius: 999px;
      padding: 12px 25px;
      font-weight: 800;
      box-shadow: 0 12px 24px rgba(251,133,0,.28);
    }

    .btn-main:hover {
      color: white;
      transform: translateY(-2px);
    }

    .btn-outline-main {
      border: 1px solid rgba(2,48,71,.22);
      border-radius: 999px;
      padding: 10px 20px;
      color: var(--azul);
      font-weight: 700;
    }

    .form-control,
    .form-select {
      border-radius: 15px;
      padding: 13px 15px;
      background: var(--fondo);
      color: var(--texto);
      border: 1px solid rgba(2,48,71,.12);
    }

    .meta-pill {
      background: rgba(33,158,188,.12);
      color: var(--azul2);
      border-radius: 999px;
      padding: 6px 10px;
      font-size: .78rem;
      font-weight: 700;
    }

    .profile-avatar {
      width: 108px;
      height: 108px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, var(--amarillo), var(--naranja));
      color: white;
      margin: 0 auto 18px;
    }

    .reco-item,
    .favorite-item,
    .check-item,
    .budget-row,
    .timeline-item {
      background: var(--fondo);
      border-radius: 18px;
      padding: 15px;
    }

    .favorite-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .place-card {
      overflow: hidden;
    }

    .place-img {
      height: 210px;
      overflow: hidden;
    }

    .place-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .place-body {
      padding: 22px;
    }

    .timeline {
      position: relative;
      padding-left: 28px;
    }

    .timeline::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 8px;
      width: 3px;
      background: rgba(33,158,188,.25);
      border-radius: 999px;
    }

    .timeline-item {
      position: relative;
      margin-bottom: 20px;
    }

    .timeline-item::before {
      content: "";
      width: 17px;
      height: 17px;
      background: var(--amarillo);
      border: 4px solid var(--azul);
      position: absolute;
      left: -28px;
      top: 22px;
      border-radius: 50%;
    }

    .progress {
      height: 13px;
      border-radius: 999px;
      background: #e6eef2;
    }

    .progress-bar {
      border-radius: 999px;
    }

    .footer {
      background: #011627;
      color: #d7e7ec;
      padding: 30px 0;
    }

    @media (max-width: 991px) {
      .user-header {
        text-align: center;
      }

      .user-header p {
        margin-left: auto;
        margin-right: auto;
      }
    }

    @media (max-width: 576px) {
      main {
        padding: 40px 0 60px;
      }

      .favorite-item {
        align-items: flex-start;
      }
    }
  </style>
</head>

<body>

<nav class="navbar navbar-expand-lg fixed-top">
  <div class="container">
    <a class="navbar-brand" href="#">
      <i class="bi bi-compass-fill text-warning me-2"></i>Descubre Puerto Montt<span>.</span>
    </a>

    <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div id="menu" class="collapse navbar-collapse">
      <ul class="navbar-nav ms-auto align-items-lg-center">
        <li class="nav-item"><a class="nav-link active" href="#panel">Panel</a></li>
        <li class="nav-item"><a class="nav-link" href="#perfil">Perfil</a></li>
        <li class="nav-item"><a class="nav-link" href="#lugares">Explorar</a></li>
        <li class="nav-item"><a class="nav-link" href="#favoritos">Favoritos</a></li>
        <li class="nav-item"><a class="nav-link" href="#itinerario">Itinerario</a></li>
        <li class="nav-item"><a class="nav-link" href="#presupuesto">Presupuesto</a></li>
        <li class="nav-item"><a class="nav-link" href="#checklist">Checklist</a></li>
        <li class="nav-item"><a class="nav-link" href="#resenas">Reseñas</a></li>
        <li class="nav-item ms-lg-2 dropdown">
          <button class="btn btn-warning rounded-pill fw-bold px-3 dropdown-toggle" data-bs-toggle="dropdown">
            <i class="bi bi-person-check me-1"></i><%= usuario.nombre %>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="#" id="logoutBtn">
              <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
            </a></li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>

<header class="user-header">
  <div class="container">
    <span class="user-badge">
      <i class="bi bi-person-check text-warning"></i> Sesión iniciada
    </span>
    <h1>Panel del usuario</h1>
    <p>
      Espacio personal para gestionar favoritos, perfil, itinerario, presupuesto, checklist, notas y reseñas del viaje por Puerto Montt.
    </p>
  </div>
</header>

<main>
  <section id="panel" class="pt-0">
    <div class="container">
      <div class="row g-4 mb-4">
        <div class="col-md-3 col-6">
          <div class="metric-card">
            <i class="bi bi-heart-fill"></i>
            <h3 id="metricFavoritos">0</h3>
            <p>Favoritos</p>
          </div>
        </div>

        <div class="col-md-3 col-6">
          <div class="metric-card">
            <i class="bi bi-list-check"></i>
            <h3 id="metricChecklist">0/0</h3>
            <p>Checklist</p>
          </div>
        </div>

        <div class="col-md-3 col-6">
          <div class="metric-card">
            <i class="bi bi-cash-coin"></i>
            <h3 id="metricPresupuesto">$0</h3>
            <p>Presupuesto</p>
          </div>
        </div>

        <div class="col-md-3 col-6">
          <div class="metric-card">
            <i class="bi bi-calendar2-week"></i>
            <h3 id="metricDias">0</h3>
            <p>Días</p>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-lg-8">
          <div class="card-box">
            <span class="section-kicker">Resumen</span>
            <h2 class="fw-bold mb-2">Hola, <%= usuario.nombre %></h2>
            <p class="text-secondary">Estas son tus recomendaciones principales para recorrer Puerto Montt según tus intereses.</p>

            <div class="row g-3 mt-2">
              <div class="col-md-4">
                <div class="reco-item h-100">
                  <strong>Angelmó</strong>
                  <p class="text-secondary small mb-2">Gastronomía marina, artesanía y mercado local.</p>
                  <span class="meta-pill">Gastronomía</span>
                </div>
              </div>

              <div class="col-md-4">
                <div class="reco-item h-100">
                  <strong>Costanera</strong>
                  <p class="text-secondary small mb-2">Paseo urbano frente al Seno de Reloncaví.</p>
                  <span class="meta-pill">Naturaleza</span>
                </div>
              </div>

              <div class="col-md-4">
                <div class="reco-item h-100">
                  <strong>Alerce Andino</strong>
                  <p class="text-secondary small mb-2">Senderos, bosque nativo y lagunas.</p>
                  <span class="meta-pill">Aventura</span>
                </div>
              </div>
            </div>

            <hr class="my-4">

            <h5 class="fw-bold">Avance de planificación</h5>

            <div class="mb-3">
              <div class="d-flex justify-content-between">
                <span>Favoritos guardados</span>
                <strong>80%</strong>
              </div>
              <div class="progress">
                <div class="progress-bar bg-warning" style="width:80%"></div>
              </div>
            </div>

            <div class="mb-3">
              <div class="d-flex justify-content-between">
                <span>Checklist completado</span>
                <strong>66%</strong>
              </div>
              <div class="progress">
                <div class="progress-bar bg-success" style="width:66%"></div>
              </div>
            </div>

            <div>
              <div class="d-flex justify-content-between">
                <span>Perfil actualizado</span>
                <strong>100%</strong>
              </div>
              <div class="progress">
                <div class="progress-bar bg-info" style="width:100%"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="side-card mb-4">
            <h5 class="fw-bold">
              <i class="bi bi-cloud-rain-heavy text-warning me-2"></i>Consejo del día
            </h5>
            <p class="text-secondary mb-0">
              Puerto Montt tiene clima variable. Lleva cortaviento, calzado cómodo y revisa el pronóstico antes de salir.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="perfil">
    <div class="container">
      <div class="section-title text-center mb-5">
        <span class="section-kicker">Perfil</span>
        <h2>Datos del usuario</h2>
        <p class="text-secondary">Administra información personal y preferencias de viaje.</p>
      </div>

      <div class="row g-4">
        <div class="col-lg-4">
          <div class="side-card text-center">
            <div class="profile-avatar">
              <i class="bi bi-person-fill display-4"></i>
            </div>
            <h4 class="fw-bold"><%= usuario.nombre %></h4>
            <p class="text-secondary">Usuario turístico</p>
            <span class="meta-pill">Cuenta activa</span>
          </div>
        </div>

        <div class="col-lg-8">
          <div class="card-box">
            <h3 class="fw-bold mb-4">Información personal</h3>

            <form id="profileForm">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-bold">Nombre completo</label>
                  <input name="nombre" class="form-control" value="<%= usuario.nombre %>" required>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-bold">Correo electrónico</label>
                  <input name="email" class="form-control" value="<%= usuario.email %>" disabled>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-bold">Interés principal</label>
                  <select name="interes_principal" class="form-select" required>
                    <option value="Naturaleza" <%= usuario.interes_principal === 'Naturaleza' ? 'selected' : '' %>>Naturaleza</option>
                    <option value="Gastronomía" <%= usuario.interes_principal === 'Gastronomía' ? 'selected' : '' %>>Gastronomía</option>
                    <option value="Cultura" <%= usuario.interes_principal === 'Cultura' ? 'selected' : '' %>>Cultura</option>
                    <option value="Familia" <%= usuario.interes_principal === 'Familia' ? 'selected' : '' %>>Familia</option>
                    <option value="Aventura" <%= usuario.interes_principal === 'Aventura' ? 'selected' : '' %>>Aventura</option>
                  </select>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-bold">Tipo de viaje</label>
                  <select name="tipo_viaje" class="form-select" required>
                    <option value="Turismo relajado" <%= usuario.tipo_viaje === 'Turismo relajado' ? 'selected' : '' %>>Turismo relajado</option>
                    <option value="Viaje familiar" <%= usuario.tipo_viaje === 'Viaje familiar' ? 'selected' : '' %>>Viaje familiar</option>
                    <option value="Aventura" <%= usuario.tipo_viaje === 'Aventura' ? 'selected' : '' %>>Aventura</option>
                    <option value="Gastronómico" <%= usuario.tipo_viaje === 'Gastronómico' ? 'selected' : '' %>>Gastronómico</option>
                  </select>
                </div>

                <div class="col-12">
                  <label class="form-label fw-bold">Preferencias</label>
                  <textarea name="preferencias" class="form-control" rows="4"><%= usuario.preferencias || '' %></textarea>
                </div>

                <div class="col-12 d-grid d-md-flex justify-content-md-end">
                  <button type="submit" class="btn btn-main">Guardar cambios</button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
  </section>

  <section id="lugares">
    <div class="container">
      <div class="section-title text-center mb-5">
        <span class="section-kicker">Explorar</span>
        <h2>Lugares disponibles</h2>
        <p class="text-secondary">Descubre todos los atractivos turísticos de Puerto Montt.</p>
      </div>

      <div id="lugaresGrid" class="row g-4">
        <!-- Los lugares se cargarán dinámicamente aquí -->
      </div>
    </div>
  </section>

  <section id="favoritos">
    <div class="container">
      <div class="section-title text-center mb-5">
        <span class="section-kicker">Favoritos</span>
        <h2>Lugares guardados</h2>
        <p class="text-secondary">Atractivos seleccionados para organizar el recorrido personalizado.</p>
      </div>

      <div id="favoritosGrid" class="row g-4">
        <!-- Los favoritos se cargarán dinámicamente aquí -->
      </div>
    </div>
  </section>

  <section id="itinerario">
    <div class="container">
      <div class="section-title text-center mb-5">
        <span class="section-kicker">Itinerario</span>
        <h2>Ruta sugerida</h2>
        <p class="text-secondary">Organización del recorrido por días.</p>
      </div>

      <div class="row g-4">
        <div class="col-lg-8">
          <div class="card-box">
            <h3 class="fw-bold mb-4">Rutas disponibles</h3>

            <div id="rutasContainer">
              <!-- Las rutas se cargarán dinámicamente aquí -->
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="side-card mb-4">
            <h5 class="fw-bold">
              <i class="bi bi-lightbulb text-warning me-2"></i>Consejo
            </h5>
            <p class="text-secondary mb-0">Deja las rutas de naturaleza para días con mejor clima y comienza temprano.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="presupuesto">
    <div class="container">
      <div class="section-title text-center mb-5">
        <span class="section-kicker">Presupuesto</span>
        <h2>Estimación de gastos</h2>
        <p class="text-secondary">Organiza alimentación, transporte, actividades y extras.</p>
      </div>

      <div class="row g-4">
        <div class="col-lg-5">
          <div class="card-box">
            <h3 class="fw-bold mb-4">Calculadora de presupuesto</h3>

            <label class="form-label fw-bold">Días de viaje</label>
            <input id="diasViaje" class="form-control mb-3" type="number" value="2" min="0">

            <label class="form-label fw-bold">Cantidad de personas</label>
            <input id="cantidadPersonas" class="form-control mb-3" type="number" value="1" min="0">

            <label class="form-label fw-bold">Estilo de viaje</label>
            <select id="estiloViaje" class="form-select mb-3">
              <option value="35000">Económico - $35.000 diarios</option>
              <option value="60000" selected>Medio - $60.000 diarios</option>
              <option value="95000">Cómodo - $95.000 diarios</option>
            </select>

            <button id="calcularPresupuesto" class="btn btn-main w-100">Actualizar presupuesto</button>
          </div>
        </div>

        <div class="col-lg-7">
          <div class="card-box">
            <h3 class="fw-bold mb-4">Resumen estimado</h3>

            <div class="budget-row d-flex justify-content-between mb-3">
              <span>Alimentación</span>
              <strong id="alimentacion">$45.000</strong>
            </div>

            <div class="budget-row d-flex justify-content-between mb-3">
              <span>Transporte</span>
              <strong id="transporte">$25.000</strong>
            </div>

            <div class="budget-row d-flex justify-content-between mb-3">
              <span>Actividades</span>
              <strong id="actividades">$30.000</strong>
            </div>

            <div class="budget-row d-flex justify-content-between mb-3">
              <span>Extras</span>
              <strong id="extras">$20.000</strong>
            </div>

            <hr>

            <div class="d-flex justify-content-between align-items-center">
              <h4 class="fw-bold mb-0">Total estimado</h4>
              <h3 id="totalEstimado" class="fw-bold text-warning mb-0">$120.000</h3>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="checklist">
    <div class="container">
      <div class="section-title text-center mb-5">
        <span class="section-kicker">Checklist y notas</span>
        <h2>Preparación del viaje</h2>
        <p class="text-secondary">Pendientes y observaciones personales del usuario.</p>
      </div>

      <div class="row g-4">
        <div class="col-lg-5">
          <div class="card-box">
            <h3 class="fw-bold mb-4">Checklist</h3>

            <form id="agregarPreparacionForm" class="mb-4">
              <div class="input-group">
                <input id="nuevoPreparacion" class="form-control" placeholder="Agregar nuevo ítem..." required>
                <button type="submit" class="btn btn-main">Agregar</button>
              </div>
            </form>

            <div id="checklistContainer" class="d-flex flex-column gap-3">
              <!-- Los ítems se cargarán dinámicamente aquí -->
            </div>
          </div>
        </div>

        <div class="col-lg-7">
          <div class="card-box">
            <h3 class="fw-bold mb-4">Notas personales</h3>
            <textarea id="notasPersonales" class="form-control mb-3" rows="10" placeholder="Escribe tus notas personales aquí..."></textarea>
            <button id="guardarNotas" class="btn btn-main">Guardar notas</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="resenas">
    <div class="container">
      <div class="section-title text-center mb-5">
        <span class="section-kicker">Reseñas</span>
        <h2>Opiniones registradas</h2>
        <p class="text-secondary">Comentarios del usuario sobre atractivos y experiencias visitadas.</p>
      </div>

      <div class="row g-4 mb-5">
        <div class="col-12">
          <div class="card-box">
            <h3 class="fw-bold mb-4">Agregar nueva opinión</h3>
            <form id="agregarOpinionForm">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-bold">Título</label>
                  <input id="opinionTitulo" class="form-control" placeholder="Título de tu opinión" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-bold">Calificación</label>
                  <select id="opinionCalificacion" class="form-select" required>
                    <option value="">Selecciona calificación</option>
                    <option value="5">★★★★★ - Excelente</option>
                    <option value="4">★★★★ - Muy bueno</option>
                    <option value="3">★★★ - Bueno</option>
                    <option value="2">★★ - Regular</option>
                    <option value="1">★ - Malo</option>
                  </select>
                </div>
                <div class="col-12">
                  <label class="form-label fw-bold">Tu opinión</label>
                  <textarea id="opinionContenido" class="form-control" rows="3" placeholder="Comparte tu experiencia..." required></textarea>
                </div>
                <div class="col-12">
                  <button type="submit" class="btn btn-main">Publicar opinión</button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>

      <div id="opinionesContainer" class="row g-4">
        <!-- Las opiniones se cargarán dinámicamente aquí -->
      </div>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="container">
    <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
      <span>© 2026 Descubre Puerto Montt</span>
    </div>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/sweetalert2/sweetalert2.all.min.js"></script>

<script>
  // Toast de bienvenida al cargar el panel
  console.log('Script ejecutándose...');
  console.log('Swal disponible:', typeof Swal !== 'undefined');
  console.log('Usuario:', '<%= usuario.nombre %>');
  
  const Toast = Swal.mixin({
    toast: true,
    position: 'top-end',
    showConfirmButton: false,
    timer: 2000,
    timerProgressBar: true,
    didOpen: (toast) => {
      toast.addEventListener('mouseenter', Swal.stopTimer)
      toast.addEventListener('mouseleave', Swal.resumeTimer)
    }
  });

  Toast.fire({
    icon: 'success',
    title: `¡Bienvenid@, <%= usuario.nombre %>!`
  }).then(() => {
    console.log('Toast mostrado exitosamente');
  }).catch((error) => {
    console.error('Error al mostrar toast:', error);
  });

  // Manejar cierre de sesión
  document.getElementById('logoutBtn').addEventListener('click', async (e) => {
    e.preventDefault();
    try {
      const response = await fetch('/api/auth/logout', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        }
      });
      if (response.ok) {
        window.location.href = '/';
      }
    } catch (error) {
      console.error('Error al cerrar sesión:', error);
      window.location.href = '/';
    }
  });

  // Manejar actualización de perfil
  document.getElementById('profileForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    try {
      const response = await fetch('/api/user/profile', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
      });

      if (response.ok) {
        const result = await response.json();
        Toast.fire({
          icon: 'success',
          title: 'Perfil actualizado exitosamente'
        });
        // Recargar la página para mostrar los datos actualizados
        setTimeout(() => {
          window.location.reload();
        }, 1500);
      } else {
        Toast.fire({
          icon: 'error',
          title: 'Error al actualizar el perfil'
        });
      }
    } catch (error) {
      console.error('Error al actualizar perfil:', error);
      Toast.fire({
        icon: 'error',
        title: 'Error al actualizar el perfil'
      });
    }
  });

  // Cargar favoritos del usuario
  async function cargarFavoritos() {
    try {
      const response = await fetch('/api/favoritos');
      if (response.ok) {
        const favoritos = await response.json();
        renderizarFavoritos(favoritos);
      }
    } catch (error) {
      console.error('Error al cargar favoritos:', error);
    }
  }

  // Renderizar favoritos en el grid
  function renderizarFavoritos(favoritos) {
    const grid = document.getElementById('favoritosGrid');
    
    if (favoritos.length === 0) {
      grid.innerHTML = '<div class="col-12 text-center"><p class="text-secondary">No tienes lugares guardados como favoritos.</p></div>';
      return;
    }

    grid.innerHTML = favoritos.map(fav => `
      <div class="col-md-6 col-lg-4">
        <article class="place-card">
          <div class="place-img">
            <img src="${fav.imagen_url || '/img/galeria/placeholder.jpg'}" alt="${fav.nombre}">
          </div>
          <div class="place-body">
            <h5 class="fw-bold">${fav.nombre}</h5>
            <p class="text-secondary">${fav.descripcion}</p>
            <div class="d-flex gap-2 flex-wrap mb-3">
              <span class="meta-pill">${fav.categoria}</span>
              <span class="meta-pill">${fav.duracion}</span>
            </div>
            <button class="btn btn-outline-main" onclick="quitarFavorito(${fav.lugar_id})">Quitar favorito</button>
          </div>
        </article>
      </div>
    `).join('');
  }

  // Quitar favorito
  async function quitarFavorito(lugarId) {
    try {
      const response = await fetch(`/api/favoritos/${lugarId}`, {
        method: 'DELETE'
      });

      if (response.ok) {
        Toast.fire({
          icon: 'success',
          title: 'Eliminado de favoritos'
        });
        cargarFavoritos(); // Recargar lista de favoritos
        cargarLugares(); // Recargar lista de lugares disponibles para actualizar estado de botones
        actualizarEstadisticas(); // Actualizar estadísticas
      } else {
        Toast.fire({
          icon: 'error',
          title: 'Error al eliminar favorito'
        });
      }
    } catch (error) {
      console.error('Error al quitar favorito:', error);
      Toast.fire({
        icon: 'error',
        title: 'Error al eliminar favorito'
      });
    }
  }

  // Cargar favoritos al iniciar
  cargarFavoritos();

  // Cargar todos los lugares disponibles
  async function cargarLugares() {
    try {
      const response = await fetch('/api/lugares');
      if (response.ok) {
        const lugares = await response.json();
        renderizarLugares(lugares);
      }
    } catch (error) {
      console.error('Error al cargar lugares:', error);
    }
  }

  // Renderizar lugares en el grid
  async function renderizarLugares(lugares) {
    const grid = document.getElementById('lugaresGrid');
    
    if (lugares.length === 0) {
      grid.innerHTML = '<div class="col-12 text-center"><p class="text-secondary">No hay lugares disponibles.</p></div>';
      return;
    }

    // Obtener favoritos del usuario para mostrar botón correcto
    let favoritosIds = [];
    try {
      const favResponse = await fetch('/api/favoritos');
      if (favResponse.ok) {
        const favoritos = await favResponse.json();
        favoritosIds = favoritos.map(f => f.lugar_id);
      }
    } catch (error) {
      console.error('Error al obtener favoritos:', error);
    }

    grid.innerHTML = lugares.map(lugar => {
      const esFavorito = favoritosIds.includes(lugar.id);
      return `
        <div class="col-md-6 col-lg-4">
          <article class="place-card">
            <div class="place-img">
              <img src="${lugar.imagen_url || '/img/galeria/placeholder.jpg'}" alt="${lugar.nombre}">
            </div>
            <div class="place-body">
              <h5 class="fw-bold">${lugar.nombre}</h5>
              <p class="text-secondary">${lugar.descripcion}</p>
              <div class="d-flex gap-2 flex-wrap mb-3">
                <span class="meta-pill">${lugar.categoria}</span>
                <span class="meta-pill">${lugar.duracion}</span>
                <span class="meta-pill">${lugar.costo}</span>
              </div>
              <button class="btn ${esFavorito ? 'btn-outline-main' : 'btn-main'}" onclick="${esFavorito ? `quitarFavorito(${lugar.id})` : `agregarFavorito(${lugar.id})`}">
                ${esFavorito ? 'Quitar favorito' : 'Agregar favorito'}
              </button>
            </div>
          </article>
        </div>
      `;
    }).join('');
  }

  // Agregar favorito
  async function agregarFavorito(lugarId) {
    try {
      const response = await fetch('/api/favoritos', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ lugar_id: lugarId })
      });

      if (response.ok) {
        Toast.fire({
          icon: 'success',
          title: 'Agregado a favoritos'
        });
        cargarLugares(); // Recargar la lista
        cargarFavoritos(); // Recargar favoritos
        actualizarEstadisticas(); // Actualizar estadísticas
      } else {
        Toast.fire({
          icon: 'error',
          title: 'Error al agregar favorito'
        });
      }
    } catch (error) {
      console.error('Error al agregar favorito:', error);
      Toast.fire({
        icon: 'error',
        title: 'Error al agregar favorito'
      });
    }
  }

  // Cargar lugares al iniciar
  cargarLugares();

  // Cargar todas las rutas disponibles
  async function cargarRutas() {
    try {
      const response = await fetch('/api/rutas');
      if (response.ok) {
        const rutas = await response.json();
        renderizarRutas(rutas);
      }
    } catch (error) {
      console.error('Error al cargar rutas:', error);
    }
  }

  // Renderizar rutas en el contenedor
  async function renderizarRutas(rutas) {
    const container = document.getElementById('rutasContainer');
    
    if (rutas.length === 0) {
      container.innerHTML = '<p class="text-secondary">No hay rutas disponibles.</p>';
      return;
    }

    // Obtener rutas guardadas del usuario
    let rutasGuardadasIds = [];
    try {
      const urResponse = await fetch('/api/usuario-rutas');
      if (urResponse.ok) {
        const rutasGuardadas = await urResponse.json();
        rutasGuardadasIds = rutasGuardadas.map(r => r.ruta_id);
      }
    } catch (error) {
      console.error('Error al obtener rutas guardadas:', error);
    }

    container.innerHTML = rutas.map(ruta => {
      const guardada = rutasGuardadasIds.includes(ruta.id);
      return `
        <div class="card mb-3">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="fw-bold mb-0">${ruta.nombre}</h5>
              <span class="badge bg-secondary">${ruta.duracion_dias} días</span>
            </div>
            <p class="text-secondary mb-2">${ruta.descripcion}</p>
            <div class="d-flex gap-2 mb-3">
              <span class="meta-pill">${ruta.categoria}</span>
              <span class="meta-pill">${ruta.dificultad}</span>
            </div>
            <button class="btn ${guardada ? 'btn-outline-main' : 'btn-main'} btn-sm" onclick="${guardada ? `quitarRutaGuardada(${ruta.id})` : `guardarRuta(${ruta.id})`}">
              ${guardada ? 'Quitar de guardadas' : 'Guardar ruta'}
            </button>
          </div>
        </div>
      `;
    }).join('');
  }

  // Guardar ruta
  async function guardarRuta(rutaId) {
    try {
      const response = await fetch('/api/usuario-rutas', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ ruta_id: rutaId })
      });

      if (response.ok) {
        Toast.fire({
          icon: 'success',
          title: 'Ruta guardada'
        });
        cargarRutas(); // Recargar la lista
      } else {
        Toast.fire({
          icon: 'error',
          title: 'Error al guardar ruta'
        });
      }
    } catch (error) {
      console.error('Error al guardar ruta:', error);
      Toast.fire({
        icon: 'error',
        title: 'Error al guardar ruta'
      });
    }
  }

  // Quitar ruta guardada
  async function quitarRutaGuardada(rutaId) {
    try {
      const response = await fetch(`/api/usuario-rutas/${rutaId}`, {
        method: 'DELETE'
      });

      if (response.ok) {
        Toast.fire({
          icon: 'success',
          title: 'Ruta eliminada'
        });
        cargarRutas(); // Recargar la lista
      } else {
        Toast.fire({
          icon: 'error',
          title: 'Error al eliminar ruta'
        });
      }
    } catch (error) {
      console.error('Error al quitar ruta:', error);
      Toast.fire({
        icon: 'error',
        title: 'Error al eliminar ruta'
      });
    }
  }

  // Cargar rutas al iniciar
  cargarRutas();

  // Cargar estadísticas del usuario
  async function cargarEstadisticas() {
    try {
      // Cargar favoritos
      const favoritosResponse = await fetch('/api/favoritos');
      if (favoritosResponse.ok) {
        const favoritos = await favoritosResponse.json();
        document.getElementById('metricFavoritos').textContent = favoritos.length || 0;
      }

      // Cargar checklist (preparación de viaje)
      const preparacionResponse = await fetch('/api/preparacion-viaje');
      if (preparacionResponse.ok) {
        const preparaciones = await preparacionResponse.json();
        const completados = preparaciones.filter(p => p.completado).length;
        document.getElementById('metricChecklist').textContent = `${completados}/${preparaciones.length}`;
      }

      // Cargar presupuesto
      const presupuestoResponse = await fetch('/api/presupuesto');
      if (presupuestoResponse.ok) {
        const presupuesto = await presupuestoResponse.json();
        document.getElementById('metricPresupuesto').textContent = '$' + (presupuesto.total_estimado || 0).toLocaleString('es-CL');
        document.getElementById('metricDias').textContent = presupuesto.dias_viaje || 0;
      }
    } catch (error) {
      console.error('Error al cargar estadísticas:', error);
    }
  }

  // Cargar estadísticas al iniciar
  cargarEstadisticas();

  // Actualizar estadísticas después de acciones
  function actualizarEstadisticas() {
    cargarEstadisticas();
  }

  // Cargar presupuesto guardado
  async function cargarPresupuesto() {
    try {
      console.log('Cargando presupuesto...');
      const response = await fetch('/api/presupuesto');
      console.log('Response status:', response.status);
      
      if (response.ok) {
        const data = await response.json();
        console.log('Datos del presupuesto:', data);
        
        const diasInput = document.getElementById('diasViaje');
        const personasInput = document.getElementById('cantidadPersonas');
        const estiloSelect = document.getElementById('estiloViaje');
        
        if (diasInput && personasInput && estiloSelect) {
          console.log('Actualizando inputs...');
          diasInput.value = data.dias_viaje;
          personasInput.value = data.cantidad_personas;
          
          // Mapear estilo de texto a valor numérico
          const estiloValor = obtenerEstiloValor(data.estilo_viaje);
          estiloSelect.value = estiloValor;
          
          console.log('Inputs actualizados:', {
            dias: diasInput.value,
            personas: personasInput.value,
            estilo: estiloSelect.value
          });
          
          // Calcular automáticamente el presupuesto con los datos cargados
          calcularPresupuestoConDatos(data.dias_viaje, data.cantidad_personas, estiloValor);
        } else {
          console.error('No se encontraron los elementos del DOM');
        }
      } else {
        console.error('Error en la respuesta del servidor, usando valores por defecto');
        // Usar valores por defecto si la API falla
        calcularPresupuestoConDatos(2, 1, 60000);
      }
    } catch (error) {
      console.error('Error al cargar presupuesto:', error);
      // Usar valores por defecto si hay error
      calcularPresupuestoConDatos(2, 1, 60000);
    }
  }

  // Mapear texto de estilo a valor numérico
  function obtenerEstiloValor(estiloTexto) {
    switch(estiloTexto) {
      case 'Económico': return 35000;
      case 'Medio': return 60000;
      case 'Cómodo': return 95000;
      default: return 60000;
    }
  }

  // Mapear valor numérico a texto de estilo
  function obtenerEstiloTexto(valor) {
    switch(parseInt(valor)) {
      case 35000: return 'Económico';
      case 60000: return 'Medio';
      case 95000: return 'Cómodo';
      default: return 'Medio';
    }
  }

  // Calcular presupuesto con datos específicos
  function calcularPresupuestoConDatos(dias, personas, estiloDiario) {
    const alimentacion = Math.round(estiloDiario * 0.375 * dias * personas);
    const transporte = Math.round(estiloDiario * 0.208 * dias * personas);
    const actividades = Math.round(estiloDiario * 0.25 * dias * personas);
    const extras = Math.round(estiloDiario * 0.167 * dias * personas);
    const total = alimentacion + transporte + actividades + extras;

    document.getElementById('alimentacion').textContent = '$' + alimentacion.toLocaleString('es-CL');
    document.getElementById('transporte').textContent = '$' + transporte.toLocaleString('es-CL');
    document.getElementById('actividades').textContent = '$' + actividades.toLocaleString('es-CL');
    document.getElementById('extras').textContent = '$' + extras.toLocaleString('es-CL');
    document.getElementById('totalEstimado').textContent = '$' + total.toLocaleString('es-CL');
  }

  // Cargar presupuesto al iniciar
  cargarPresupuesto();

  // Calcular presupuesto
  document.getElementById('calcularPresupuesto').addEventListener('click', async function() {
    console.log('Botón calcular presupuesto clickeado');
    const dias = parseInt(document.getElementById('diasViaje').value) || 0;
    const personas = parseInt(document.getElementById('cantidadPersonas').value) || 0;
    const estiloDiario = parseInt(document.getElementById('estiloViaje').value) || 0;

    console.log('Valores:', { dias, personas, estiloDiario });

    // Calcular costos por categoría (porcentajes aproximados)
    const alimentacion = Math.round(estiloDiario * 0.375 * dias * personas); // 37.5%
    const transporte = Math.round(estiloDiario * 0.208 * dias * personas); // 20.8%
    const actividades = Math.round(estiloDiario * 0.25 * dias * personas); // 25%
    const extras = Math.round(estiloDiario * 0.167 * dias * personas); // 16.7%

    const total = alimentacion + transporte + actividades + extras;

    console.log('Cálculos:', { alimentacion, transporte, actividades, extras, total });

    // Actualizar el resumen
    const alimentacionEl = document.getElementById('alimentacion');
    const transporteEl = document.getElementById('transporte');
    const actividadesEl = document.getElementById('actividades');
    const extrasEl = document.getElementById('extras');
    const totalEl = document.getElementById('totalEstimado');

    if (alimentacionEl) alimentacionEl.textContent = '$' + alimentacion.toLocaleString('es-CL');
    if (transporteEl) transporteEl.textContent = '$' + transporte.toLocaleString('es-CL');
    if (actividadesEl) actividadesEl.textContent = '$' + actividades.toLocaleString('es-CL');
    if (extrasEl) extrasEl.textContent = '$' + extras.toLocaleString('es-CL');
    if (totalEl) totalEl.textContent = '$' + total.toLocaleString('es-CL');

    console.log('Elementos actualizados');

    // Guardar presupuesto en la base de datos
    try {
      const estiloTexto = obtenerEstiloTexto(estiloDiario);
      const response = await fetch('/api/presupuesto', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          dias_viaje: dias,
          cantidad_personas: personas,
          estilo_viaje: estiloTexto,
          total_estimado: total
        })
      });
      console.log('Respuesta guardar presupuesto:', response.status);
    } catch (error) {
      console.error('Error al guardar presupuesto:', error);
    }

    Toast.fire({
      icon: 'success',
      title: 'Presupuesto actualizado y guardado'
    });
    actualizarEstadisticas();
  });

  // Cargar preparación del viaje
  async function cargarPreparacion() {
    try {
      const response = await fetch('/api/preparacion-viaje');
      if (response.ok) {
        const preparaciones = await response.json();
        renderizarPreparacion(preparaciones);
      }
    } catch (error) {
      console.error('Error al cargar preparación:', error);
    }
  }

  // Renderizar ítems de preparación
  function renderizarPreparacion(preparaciones) {
    const container = document.getElementById('checklistContainer');
    
    if (preparaciones.length === 0) {
      container.innerHTML = '<p class="text-secondary">No hay ítems en el checklist.</p>';
      return;
    }

    container.innerHTML = preparaciones.map(prep => `
      <label class="check-item">
        <input class="form-check-input me-2" type="checkbox" ${prep.completado ? 'checked' : ''} onchange="marcarCompletado(${prep.id}, this.checked)">
        ${prep.titulo}
        <button class="btn btn-sm btn-link text-danger ms-auto" onclick="eliminarPreparacion(${prep.id})">
          <i class="bi bi-trash"></i>
        </button>
      </label>
    `).join('');
  }

  // Agregar nuevo ítem de preparación
  const agregarPreparacionForm = document.getElementById('agregarPreparacionForm');
  if (agregarPreparacionForm) {
    agregarPreparacionForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const titulo = document.getElementById('nuevoPreparacion').value;

      try {
        const response = await fetch('/api/preparacion-viaje', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ titulo, descripcion: '', categoria: 'Otro' })
        });

        if (response.ok) {
          Toast.fire({
            icon: 'success',
            title: 'Ítem agregado'
          });
          document.getElementById('nuevoPreparacion').value = '';
          cargarPreparacion();
          actualizarEstadisticas();
        } else {
          Toast.fire({
            icon: 'error',
            title: 'Error al agregar ítem'
          });
        }
      } catch (error) {
        console.error('Error al agregar preparación:', error);
        Toast.fire({
          icon: 'error',
          title: 'Error al agregar ítem'
        });
      }
    });
  }

  // Marcar ítem como completado
  async function marcarCompletado(id, completado) {
    try {
      const response = await fetch(`/api/preparacion-viaje/${id}/completado`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ completado })
      });

      if (response.ok) {
        cargarPreparacion();
        actualizarEstadisticas();
      }
    } catch (error) {
      console.error('Error al marcar completado:', error);
    }
  }

  // Eliminar ítem de preparación
  async function eliminarPreparacion(id) {
    try {
      const response = await fetch(`/api/preparacion-viaje/${id}`, {
        method: 'DELETE'
      });

      if (response.ok) {
        Toast.fire({
          icon: 'success',
          title: 'Ítem eliminado'
        });
        cargarPreparacion();
        actualizarEstadisticas();
      } else {
        Toast.fire({
          icon: 'error',
          title: 'Error al eliminar ítem'
        });
      }
    } catch (error) {
      console.error('Error al eliminar preparación:', error);
      Toast.fire({
        icon: 'error',
        title: 'Error al eliminar ítem'
      });
    }
  }

  // Hacer funciones accesibles globalmente para onclick
  window.marcarCompletado = marcarCompletado;
  window.eliminarPreparacion = eliminarPreparacion;

  // Cargar preparación al iniciar
  cargarPreparacion();

  // Cargar notas personales desde la API
  async function cargarNotasPersonales() {
    try {
      const response = await fetch('/api/user/notas');
      if (response.ok) {
        const data = await response.json();
        const textarea = document.getElementById('notasPersonales');
        if (textarea) {
          textarea.value = data.notas_personales || '';
        }
      }
    } catch (error) {
      console.error('Error al cargar notas:', error);
    }
  }

  // Guardar notas personales
  document.getElementById('guardarNotas').addEventListener('click', async () => {
    const notas_personales = document.getElementById('notasPersonales').value;

    try {
      const response = await fetch('/api/user/notas', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ notas_personales })
      });

      if (response.ok) {
        Toast.fire({
          icon: 'success',
          title: 'Notas guardadas'
        });
      } else {
        Toast.fire({
          icon: 'error',
          title: 'Error al guardar notas'
        });
      }
    } catch (error) {
      console.error('Error al guardar notas:', error);
      Toast.fire({
        icon: 'error',
        title: 'Error al guardar notas'
      });
    }
  });

  // Cargar notas al iniciar
  cargarNotasPersonales();

  // Cargar opiniones del usuario
  async function cargarOpiniones() {
    try {
      const response = await fetch('/api/opiniones/usuario/mis-opiniones');
      if (response.ok) {
        const opiniones = await response.json();
        renderizarOpiniones(opiniones);
      }
    } catch (error) {
      console.error('Error al cargar opiniones:', error);
    }
  }

  // Renderizar opiniones
  function renderizarOpiniones(opiniones) {
    const container = document.getElementById('opinionesContainer');
    
    if (opiniones.length === 0) {
      container.innerHTML = '<div class="col-12 text-center"><p class="text-secondary">No hay opiniones registradas.</p></div>';
      return;
    }

    container.innerHTML = opiniones.map(opinion => {
      const estrellas = '★'.repeat(opinion.calificacion) + '☆'.repeat(5 - opinion.calificacion);
      return `
        <div class="col-6">
          <div class="review-card">
            <div class="d-flex justify-content-between mb-2">
              <strong>${opinion.titulo}</strong>
              <span class="text-warning">${estrellas}</span>
            </div>
            <p class="text-secondary mb-2">${opinion.contenido}</p>
            <small class="text-muted">Por ${opinion.nombre_usuario} - ${new Date(opinion.creado_en).toLocaleDateString('es-CL')}</small>
          </div>
        </div>
      `;
    }).join('');
  }

  // Cargar opiniones al iniciar
  cargarOpiniones();

  // Agregar nueva opinión
  const agregarOpinionForm = document.getElementById('agregarOpinionForm');
  if (agregarOpinionForm) {
    agregarOpinionForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const titulo = document.getElementById('opinionTitulo').value;
      const calificacion = parseInt(document.getElementById('opinionCalificacion').value);
      const contenido = document.getElementById('opinionContenido').value;

      try {
        const response = await fetch('/api/opiniones', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ titulo, calificacion, contenido, lugar_id: null })
        });

        if (response.ok) {
          Toast.fire({
            icon: 'success',
            title: 'Opinión publicada'
          });
          agregarOpinionForm.reset();
          cargarOpiniones();
        } else {
          Toast.fire({
            icon: 'error',
            title: 'Error al publicar opinión'
          });
        }
      } catch (error) {
        console.error('Error al agregar opinión:', error);
        Toast.fire({
          icon: 'error',
          title: 'Error al publicar opinión'
        });
      }
    });
  }

  const sections = document.querySelectorAll("main section");
  const navLinks = document.querySelectorAll(".nav-link[href^='#']");
  const navbarHeight = 80;

  window.addEventListener("scroll", () => {
    let current = "";
    
    sections.forEach(section => {
      const sectionTop = section.offsetTop - navbarHeight - 20;
      const sectionBottom = sectionTop + section.offsetHeight;
      
      if (window.scrollY >= sectionTop && window.scrollY < sectionBottom) {
        current = section.getAttribute("id");
      }
    });

    navLinks.forEach(link => {
      link.classList.remove("active");
      if (link.getAttribute("href") === "#" + current) {
        link.classList.add("active");
      }
    });
  });

  // Ejecutar al cargar para establecer el estado inicial
  window.dispatchEvent(new Event("scroll"));
</script>

</body>
</html>
